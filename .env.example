# One file per Jira site. Keep real files OUTSIDE the repository, e.g. ~/.config/mcp-jira/<name>.env
# (`just init <name> <port>` creates one with 0600 permissions).

# ---- Instance ----
# Label the agent sees; tells it which organisation this Jira belongs to.
JIRA_INSTANCE_NAME=acme
# Optional: when the agent should use this instance.
JIRA_AGENT_HINT=
# Localhost port this instance is published on (used by `just up`).
MCP_PORT=8711

# ---- Atlassian OAuth 2.0 (3LO) app: https://developer.atlassian.com/console/myapps/ ----
# Set all three or none (none = the server starts, tools answer "not signed in").
# e.g. https://acme.atlassian.net
JIRA_SITE_URL=
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# ---- Deployment (leave empty locally) ----
# Public URL when not on localhost, e.g. https://jira-mcp.example.com
# BASE_URL=
# Mount prefix behind a shared ingress, e.g. /api/jira
# BASE_API_PATH=
# Restrict MCP client callback URLs, e.g. http://localhost:*,https://claude.ai/*
# ALLOWED_CLIENT_REDIRECT_URIS=
# Stable signing key for tokens issued to MCP clients (32+ random bytes)
# JWT_SIGNING_KEY=
# OAuth state: file (default, needs a persistent /data) | redis | dynamodb
# OAUTH_STORAGE=file
# Fernet key for redis/dynamodb:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# OAUTH_STORAGE_ENCRYPTION_KEY=
# OAUTH_REDIS_URL=redis://redis:6379/0
# OAUTH_DYNAMODB_TABLE=mcp-jira-oauth
# OAUTH_DYNAMODB_REGION=eu-central-1
# Accept URL client IDs (CIMD); off = dynamic client registration (works everywhere)
# OAUTH_ENABLE_CIMD=false
# always (default, safest) | remember
# OAUTH_CONSENT=always
# ENVIRONMENT=production  (JSON logs)
# LOG_LEVEL=info
